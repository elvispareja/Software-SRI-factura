# Copia a .env y completa los valores antes de producción.
# Nunca subas .env al repositorio.

# --- Seguridad ---
CLAVE_SECRETA=desarrollo-no-usar-en-produccion
# En prod (AMBIENTE=2) CLAVE_SECRETA es obligatoria; el backend falla al arrancar si es la de desarrollo.
AMBIENTE=1
HORAS_VIGENCIA_TOKEN=12
COOKIE_SEGURA=false
COOKIE_SAMESITE=lax

# --- CORS ---
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173
VITE_URL_API=http://localhost:8000/api

# --- Base de datos ---
# Obligatoria: el backend no arranca sin ella. Único motor soportado: PostgreSQL.
URL_BASE_DATOS=postgresql+psycopg://factoa:factoa@localhost:5432/factoa
POSTGRES_USER=factoa
POSTGRES_PASSWORD=factoa
POSTGRES_DB=factoa

# --- WhatsApp (opcional) ---
WHATSAPP_SECRETO_APP=
WHATSAPP_TOKEN_ACCESO=
WHATSAPP_ID_NUMERO=
WHATSAPP_TOKEN_VERIFICACION=
# Extracción de datos de facturación desde el texto de WhatsApp.
GEMINI_API_KEY=
# Modelo de extracción; por defecto gemini-2.5-flash.
MODELO_IA=

# OCR de las imágenes que llegan por WhatsApp (foto de RUC/recibo).
ANTHROPIC_API_KEY=
# Modelo usado para ese OCR; por defecto claude-opus-5.
MODELO_CLAUDE=

# Transcripción de los audios que llegan por WhatsApp (API Whisper de OpenAI).
# Sin esta clave, un audio recibido responde "transcripción no configurada"
# en vez de fallar: revisa app/routers/whatsapp.py si prefieres el fallback
# local con faster-whisper (no se instala por defecto, es pesado).
OPENAI_API_KEY=

# --- Fase 4 (no usar aún) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# --------------------------------------------------------------------------
# Envío del comprobante autorizado al receptor (XML + RIDE adjuntos).
# Sin SMTP_SERVIDOR el envío queda deshabilitado y la interfaz lo explica,
# en vez de fallar con un error de red.
# --------------------------------------------------------------------------
SMTP_SERVIDOR=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
# Remitente visible; si se omite se usa SMTP_USUARIO.
SMTP_REMITENTE=
# true para SSL directo (puerto 465); vacío usa STARTTLS en el 587.
SMTP_SSL=
